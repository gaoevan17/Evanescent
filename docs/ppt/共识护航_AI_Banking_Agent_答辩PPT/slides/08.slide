<Slide style={{ padding: 48, background: '#ffffff' }}>
  <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#0f172a', marginBottom: 8 }}>安全设计</Text>
  <Box style={{ width: 60, height: 5, background: '#1a73e8', borderRadius: 3, marginBottom: 24 }} />
  <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 12 }}>
    {[
      { t: '确定性权限', d: '模型/前端/用户文本不可降级' },
      { t: '防编造结果', d: '回执仅来自授权工具回读' },
      { t: '防提示注入', d: '备注/检索结果作为不可信数据' },
      { t: '对象级权限', d: '服务端按身份过滤，跨库隔离' },
      { t: '幂等防重', d: '幂等键 + 原子 UPDATE' },
      { t: '强验证', d: '挑战·过期·一次性·防重放·限次' },
      { t: '完整审计', d: '身份/意图/决策/证据/回执（不含密钥）' },
      { t: '熔断锁定', d: '连续失败熔断，阈值团队配置' },
      { t: '受限环境', d: '默认禁用任意代码执行' },
    ].map((x, i) => (
      <Box key={i} style={{ width: 380, borderRadius: 10, padding: 18, background: '#f0f4f8', gap: 6, borderLeft: '4px solid #1a73e8' }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0f172a' }}>{x.t}</Text>
        <Text style={{ fontSize: 13, color: '#64748b' }}>{x.d}</Text>
      </Box>
    ))}
  </Box>
</Slide>
