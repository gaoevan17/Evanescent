# ============================================================
# 共识护航 AI Banking Agent —— 环境配置示例
# 复制本文件为 .env 并按需修改。切勿把真实密钥提交到仓库/压缩包。
# ============================================================

# 运行模式：offline = 离线测试模式（无需大模型，确定性规则解析器）
#          llm     = 真实大模型接入模式
APP_MODE=offline

# 大模型接入（仅 APP_MODE=llm 时使用，兼容 OpenAI 协议）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 服务监听
HOST=127.0.0.1
PORT=8000

# 数据库文件路径（相对项目根目录）
DATABASE_URL=sqlite:///./data/consensus_guardian.db

# 会话/认证
# 会话有效期（秒）
SESSION_TTL=86400
# 强验证挑战（模拟短信 OTP）有效期（秒）
CHALLENGE_TTL=300
# 强验证挑战最大尝试次数
CHALLENGE_MAX_ATTEMPTS=5

# 安全熔断阈值（团队配置策略）
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_WINDOW_SECONDS=300

# 时区（执行日按北京时间）
TZ=Asia/Shanghai

# 演示账号密码（仅模拟环境）
DEMO_ALICE_PASSWORD=demo123456
DEMO_BOB_PASSWORD=demo123456
DEMO_CAROL_PASSWORD=demo123456
